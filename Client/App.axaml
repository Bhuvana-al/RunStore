<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Client"
             x:Class="Client.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator></local:ViewLocator>
    </Application.DataTemplates>
    
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Styles/LabelStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/AppStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/MenuButtonStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/TextBlockStyles.axaml"></StyleInclude>
        <StyleInclude Source="Assets/Styles/TextBoxStyles.axaml"></StyleInclude>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="MontserratFont">avares://Client/Assets/Fonts#Montserrat</FontFamily>    
            <FontFamily x:Key="IconFont">avares://Client/Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/Resources/ColorsResources.axaml" />
                <ResourceInclude Source="Assets/Resources/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <!-- <SolidColorBrush x:Key="PrimaryTextColor">#EAE8E8</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBackgroundColor">#04041F</SolidColorBrush>

        <LinearGradientBrush x:Key="PrimaryBackgroundGradient" StartPoint="0% 0%" EndPoint="100% 0%">
            <GradientStop Offset="0" Color="#04041F" />
            <GradientStop Offset="1" Color="#151E3E" />
        </LinearGradientBrush>

        <FontFamily x:Key="MontserratFont">avares://Client/Assets/Fonts#Montserrat</FontFamily>    
        <FontFamily x:Key="CreepsterFont">avares://Client/Assets/Fonts/Creepster-Regular.ttf#Creepster</FontFamily>    
        <FontFamily x:Key="IconFont">avares://Client/Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily> -->

    </Application.Resources>

</Application>